{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Antenna Solver GPT experiment configuration v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "model_status",
    "antenna",
    "simulation",
    "requested_outputs",
    "provenance",
    "solver"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
    },
    "model_status": {
      "enum": [
        "unvalidated",
        "validated"
      ]
    },
    "antenna": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "parameter_schema",
        "parameters"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "parameter_schema": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frequency_hz",
        "medium",
        "conductor_model",
        "reflector_model",
        "feed_model",
        "reference_impedance_ohm",
        "accepted_power_w",
        "phasor_convention"
      ],
      "properties": {
        "frequency_hz": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "medium": {
          "const": "vacuum"
        },
        "conductor_model": {
          "const": "PEC"
        },
        "reflector_model": {
          "enum": [
            "pec_plate",
            "none"
          ]
        },
        "feed_model": {
          "const": "differential_lumped_port"
        },
        "reference_impedance_ohm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "accepted_power_w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "phasor_convention": {
          "const": "real(F * exp(+j * phase))"
        }
      }
    },
    "requested_outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currents",
        "impedance",
        "far_field",
        "field_planes",
        "phase_degrees",
        "full_period_animation"
      ],
      "properties": {
        "currents": {
          "type": "boolean"
        },
        "impedance": {
          "type": "boolean"
        },
        "far_field": {
          "type": "boolean"
        },
        "field_planes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "xz",
              "yz",
              "xy_front"
            ]
          }
        },
        "phase_degrees": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 360
          }
        },
        "full_period_animation": {
          "type": "boolean"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_file",
        "scaling_reference_frequency_hz",
        "scaling_target_frequency_hz",
        "scale_factor",
        "reference_frequency_status",
        "scaling_mode",
        "note"
      ],
      "properties": {
        "source_file": {
          "type": "string"
        },
        "scaling_reference_frequency_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "scaling_target_frequency_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "scale_factor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reference_frequency_status": {
          "enum": [
            "assumed_not_verified",
            "verified"
          ]
        },
        "scaling_mode": {
          "enum": [
            "all_physical_dimensions",
            "custom_dimensions"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "cells_per_wire_diameter",
        "cells_per_wavelength",
        "growth_ratio",
        "padding_wavelengths",
        "pml_cells",
        "max_cells",
        "max_timesteps",
        "end_criteria",
        "threads",
        "excitation_fractional_bandwidth",
        "far_field_step_deg"
      ],
      "properties": {
        "name": {
          "const": "openEMS"
        },
        "cells_per_wire_diameter": {
          "type": "integer",
          "minimum": 2,
          "maximum": 12
        },
        "cells_per_wavelength": {
          "type": "integer",
          "minimum": 10,
          "maximum": 100
        },
        "growth_ratio": {
          "type": "number",
          "minimum": 1.05,
          "maximum": 1.5
        },
        "padding_wavelengths": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 2
        },
        "pml_cells": {
          "type": "integer",
          "minimum": 8,
          "maximum": 20
        },
        "max_cells": {
          "type": "integer",
          "minimum": 1000
        },
        "max_timesteps": {
          "type": "integer",
          "minimum": 1000
        },
        "end_criteria": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.0001
        },
        "threads": {
          "type": "integer",
          "minimum": 0
        },
        "excitation_fractional_bandwidth": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.8
        },
        "far_field_step_deg": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15
        }
      }
    }
  }
}
