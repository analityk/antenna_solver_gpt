{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Antenna Lab experiment configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "model_status",
    "antenna",
    "simulation",
    "requested_outputs",
    "provenance"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
    },
    "model_status": {
      "enum": [
        "unvalidated",
        "validated"
      ]
    },
    "antenna": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "parameter_schema",
        "parameters"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "parameter_schema": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frequency_hz",
        "medium",
        "conductor_model",
        "reflector_model",
        "feed_model",
        "reference_impedance_ohm",
        "accepted_power_w",
        "phasor_convention"
      ],
      "properties": {
        "frequency_hz": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "medium": {
          "const": "vacuum"
        },
        "conductor_model": {
          "const": "PEC"
        },
        "reflector_model": {
          "enum": [
            "connected_wire_grid",
            "none"
          ]
        },
        "feed_model": {
          "const": "ideal_balanced_port"
        },
        "reference_impedance_ohm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "accepted_power_w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "phasor_convention": {
          "const": "real(F * exp(+j * phase))"
        }
      }
    },
    "requested_outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currents",
        "impedance",
        "far_field",
        "field_planes",
        "phase_degrees",
        "full_period_animation"
      ],
      "properties": {
        "currents": {
          "type": "boolean"
        },
        "impedance": {
          "type": "boolean"
        },
        "far_field": {
          "type": "boolean"
        },
        "field_planes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "xz",
              "yz",
              "xy_front"
            ]
          }
        },
        "phase_degrees": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 360
          }
        },
        "full_period_animation": {
          "type": "boolean"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_file",
        "scaling_reference_frequency_hz",
        "scaling_target_frequency_hz",
        "scale_factor",
        "reference_frequency_status",
        "scaling_mode",
        "note"
      ],
      "properties": {
        "source_file": {
          "type": "string"
        },
        "scaling_reference_frequency_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "scaling_target_frequency_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "scale_factor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reference_frequency_status": {
          "enum": [
            "assumed_not_verified",
            "verified"
          ]
        },
        "scaling_mode": {
          "enum": [
            "all_physical_dimensions",
            "custom_dimensions"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
