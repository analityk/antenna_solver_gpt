{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Antenna Solver GPT run manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "stage",
    "status",
    "created_at",
    "code",
    "configuration_sha256",
    "frequency_hz",
    "solver",
    "coordinates",
    "normalization",
    "validation_status",
    "warnings",
    "error",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "geometry",
        "openems_input",
        "simulation"
      ]
    },
    "status": {
      "enum": [
        "running",
        "prepared",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "code": {
      "type": "object",
      "required": [
        "version",
        "commit_sha",
        "dirty"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "commit_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "frequency_hz": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "solver": {
      "type": [
        "object",
        "null"
      ]
    },
    "coordinates": {
      "type": "object",
      "required": [
        "cartesian",
        "spherical",
        "polarization_basis"
      ]
    },
    "normalization": {
      "type": "object",
      "required": [
        "accepted_power_w",
        "amplitude_convention",
        "phase_reference",
        "phasor_convention",
        "applied"
      ],
      "properties": {
        "accepted_power_w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "amplitude_convention": {
          "const": "peak"
        },
        "applied": {
          "type": "boolean"
        }
      }
    },
    "validation_status": {
      "enum": [
        "unverified",
        "passed",
        "failed"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "$comment": "Completed geometry is not a completed EM simulation. Prepared means XML only. All current numerical results remain unverified. Artifact hashes exclude the manifest itself."
}
