{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Biquad parameters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["dimensions_m"],
  "properties": {
    "dimensions_m": {
      "type": "object",
      "additionalProperties": false,
      "required": ["S", "G", "H", "wire_diameter", "reflector_length", "reflector_width", "reflector_thickness"],
      "properties": {
        "S": {"type": "number", "exclusiveMinimum": 0},
        "G": {"type": "number", "exclusiveMinimum": 0},
        "H": {"type": "number", "exclusiveMinimum": 0},
        "wire_diameter": {"type": "number", "exclusiveMinimum": 0},
        "reflector_length": {"type": "number", "exclusiveMinimum": 0},
        "reflector_width": {"type": "number", "exclusiveMinimum": 0},
        "reflector_thickness": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
