{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PCB v0 configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model",
    "files",
    "copper",
    "substrate",
    "port"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "model": {
      "const": "pcb"
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "copper_top",
        "board_outline"
      ],
      "properties": {
        "copper_top": {
          "type": "string",
          "minLength": 1
        },
        "board_outline": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "copper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thickness_um",
        "conductivity_s_m",
        "model"
      ],
      "properties": {
        "thickness_um": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "conductivity_s_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "model": {
          "const": "pec"
        }
      }
    },
    "substrate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thickness_mm",
        "epsilon_r",
        "loss_tangent"
      ],
      "properties": {
        "thickness_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "epsilon_r": {
          "type": "number",
          "minimum": 1
        },
        "loss_tangent": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "negative_mm",
        "positive_mm",
        "width_mm"
      ],
      "properties": {
        "negative_mm": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "positive_mm": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "width_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
