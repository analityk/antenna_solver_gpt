{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Antenna Lab run manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "status",
    "created_at",
    "code",
    "solver",
    "configuration_sha256",
    "frequency_hz",
    "coordinates",
    "normalization",
    "artifacts",
    "validation_status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
    },
    "status": {
      "enum": [
        "running",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_sha",
        "dirty"
      ],
      "properties": {
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "source_snapshot_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "settings"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "build_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "settings": {
          "type": "object"
        }
      }
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "frequency_hz": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "coordinates": {
      "type": "object",
      "required": [
        "cartesian",
        "spherical",
        "polarization_basis"
      ],
      "properties": {
        "cartesian": {
          "type": "string"
        },
        "spherical": {
          "type": "string"
        },
        "polarization_basis": {
          "type": "string"
        }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_power_w",
        "amplitude_convention",
        "phasor_convention",
        "raw_solution"
      ],
      "properties": {
        "accepted_power_w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "amplitude_convention": {
          "const": "peak"
        },
        "phasor_convention": {
          "const": "real(F * exp(+j * phase))"
        },
        "raw_solution": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "frequency_hz",
              "accepted_power_w",
              "voltage_real_v",
              "voltage_imag_v",
              "amplitude_scale"
            ],
            "properties": {
              "frequency_hz": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "accepted_power_w": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "voltage_real_v": {
                "type": "number"
              },
              "voltage_imag_v": {
                "type": "number"
              },
              "amplitude_scale": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "validation_status": {
      "enum": [
        "unverified",
        "passed",
        "failed"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$comment": "Completed runs must satisfy the requested artifact set in outcomes/README.md. Check artifact hashes and array lengths outside JSON Schema. Dirty source requires a saved source snapshot."
}
